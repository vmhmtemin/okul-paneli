<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)">
<title>{{ r.title }}</title>
<style>
  :root {
    --bg: #f6f5f1; --surface: #ffffff; --surface-2: #f0efe9; --line: #e3e1d9;
    --text: #1d1d1f; --muted: #6b6a66; --accent: #2f5bd3; --on-accent: #ffffff;
    --urgent: #c2410c; --urgent-bg: #fff1e8;
    --k-exam: #b42318; --k-exam-bg: #fdecea;
    --k-assignment: #2f5bd3; --k-assignment-bg: #eaf0fd;
    --k-meeting: #187a4a; --k-meeting-bg: #e6f5ec;
    --k-followup: #946200; --k-followup-bg: #fdf3dc;
    --k-cancel: #55534e; --k-cancel-bg: #efeee9;
    --k-own: #7a3fc4; --k-own-bg: #f2eafd;
    --note-bg: #fff3a6; --note-line: #e9d76a; --note-text: #3b3410;
    --radius: 14px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16171a; --surface: #1f2024; --surface-2: #26282d; --line: #33353b;
      --text: #ececee; --muted: #a0a0a8; --accent: #8aa8ff; --on-accent: #0f1220;
      --urgent: #ff9a62; --urgent-bg: #3a2418;
      --k-exam: #ff8b80; --k-exam-bg: #3b1f1d;
      --k-assignment: #8aa8ff; --k-assignment-bg: #1f2742;
      --k-meeting: #6fd39d; --k-meeting-bg: #183026;
      --k-followup: #f2c35b; --k-followup-bg: #352a12;
      --k-cancel: #c4c3be; --k-cancel-bg: #2c2d31;
      --k-own: #c9a4ff; --k-own-bg: #2d2340;
      --note-bg: #4a4220; --note-line: #6b5f2c; --note-text: #fff6c8;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; overscroll-behavior-y: contain; }   /* aşağı çekince sayfa yenilenmesin */
  body {
    margin: 0; background: var(--bg); color: var(--text); overscroll-behavior-y: contain;
    font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    overflow-wrap: anywhere; -webkit-tap-highlight-color: transparent;
  }
  body.modal-open { overflow: hidden; }
  button, input, textarea { font: inherit; color: inherit; }
  button { cursor: pointer; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 16px; }
  main.wrap { padding-bottom: calc(32px + env(safe-area-inset-bottom)); }

  /* ---------- Başlık ---------- */
  header.top {
    position: sticky; top: 0; z-index: 5; background: var(--bg);
    border-bottom: 1px solid var(--line); padding: calc(10px + env(safe-area-inset-top)) 0 10px;
  }
  .top-in { display: flex; align-items: center; gap: 12px; justify-content: space-between; }
  h1 { font-size: 1.1rem; line-height: 1.25; margin: 0; letter-spacing: -0.01em; }
  .updated { color: var(--muted); font-size: .78rem; margin-top: 2px; }
  .stats { display: flex; gap: 6px; flex-shrink: 0; }
  .stat {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-width: 50px; min-height: 44px; padding: 2px 8px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--line);
  }
  .stat b { font-size: 1rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stat span { font-size: .64rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .stat.urgent b { color: var(--urgent); }

  /* ---------- Not kağıdı ---------- */
  .note {
    position: relative; margin: 18px 4px 4px; padding: 26px 14px 10px;
    background: var(--note-bg); color: var(--note-text); border-radius: 4px 4px 14px 4px;
    box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 6px 14px -8px rgba(0,0,0,.25);
    transform: rotate(-0.6deg);
  }
  .note::before {                           /* bant */
    content: ""; position: absolute; top: -9px; left: 50%; width: 84px; height: 20px; margin-left: -42px;
    background: rgba(255,255,255,.55); border: 1px solid rgba(0,0,0,.06); transform: rotate(2deg);
  }
  .note-title {
    font-family: "Marker Felt", "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive;
    font-size: 1.35rem; font-weight: 700; line-height: 1.1; margin: 0 0 6px;
  }
  .note textarea {
    display: block; width: 100%; min-height: 72px; resize: none; border: 0; outline: 0; padding: 0;
    background: repeating-linear-gradient(transparent 0 27px, var(--note-line) 27px 28px);
    color: var(--note-text); font-size: 16px; line-height: 28px; overflow: hidden;
    font-family: "Bradley Hand", "Segoe Print", "Comic Sans MS", -apple-system, sans-serif;
  }
  .note textarea::placeholder { color: color-mix(in srgb, var(--note-text) 45%, transparent); }
  .note-status { font-size: .72rem; text-align: right; opacity: .7; min-height: 1.1em; }

  /* ---------- Filtreler ---------- */
  .filters {
    display: flex; gap: 8px; overflow-x: auto; padding: 16px 2px 2px; margin: 0 -2px;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .filters::-webkit-scrollbar { display: none; }
  .chip {
    flex-shrink: 0; min-height: 44px; padding: 0 14px; border-radius: 999px; white-space: nowrap;
    border: 1px solid var(--line); background: var(--surface); font-size: .88rem; font-weight: 500;
  }
  .chip[aria-pressed="true"] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .chip.cats { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }

  /* ---------- Katlanır bölümler ---------- */
  .sec { margin-top: 18px; }
  .sec-head {
    width: 100%; display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 4px;
    border: 0; background: none; text-align: left;
    font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700;
  }
  .sec-head .count { font-variant-numeric: tabular-nums; }
  .chev { margin-left: auto; width: 10px; height: 10px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
          transform: rotate(45deg); transition: transform .15s; margin-right: 6px; flex-shrink: 0; }
  .sec.collapsed .chev { transform: rotate(-45deg); }
  .sec.collapsed .sec-body { display: none; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .summary { padding: 12px 16px; }
  .summary ul { margin: 0; padding-left: 1.1em; }
  .summary li + li { margin-top: 6px; }

  /* ---------- Yapılacaklar ---------- */
  .todo-tools { display: flex; gap: 8px; margin-bottom: 10px; }
  .add-btn {
    flex: 1; min-height: 46px; border-radius: 12px; border: 1.5px dashed var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface)); color: var(--accent); font-weight: 600;
  }
  .ghost-btn { min-height: 46px; padding: 0 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); font-size: .82rem; }
  .bucket { font-size: .76rem; font-weight: 700; color: var(--muted); padding: 12px 16px 2px; }
  .bucket.urgent { color: var(--urgent); }
  .bucket.overdue { color: var(--k-exam); }
  .todo { display: flex; align-items: stretch; border-top: 1px solid var(--line); }
  .bucket + .todo { border-top: 0; }
  .check-hit { display: flex; align-items: flex-start; justify-content: center; width: 52px; min-height: 56px; flex-shrink: 0; padding-top: 13px; cursor: pointer; }
  .check {
    appearance: none; -webkit-appearance: none; margin: 0; flex-shrink: 0;
    width: 26px; height: 26px; border-radius: 8px; border: 2px solid var(--line); background: var(--surface);
    display: grid; place-content: center; transition: background .15s, border-color .15s;
  }
  .check::after { content: ""; width: 12px; height: 7px; border: solid var(--on-accent); border-width: 0 0 2.5px 2.5px;
    transform: rotate(-45deg) translate(1px, -1px); opacity: 0; }
  .check:checked { background: var(--accent); border-color: var(--accent); }
  .check:checked::after { opacity: 1; }
  .check:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 40%, transparent); outline-offset: 2px; }
  .todo-open { flex: 1; min-width: 0; display: block; border: 0; background: none; text-align: left; padding: 11px 6px 11px 0; min-height: 56px; }
  .todo-title { display: block; font-weight: 600; line-height: 1.35; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; margin-top: 4px; font-size: .84rem; color: var(--muted); }
  .when { color: var(--text); font-weight: 500; }
  .todo.urgent .when { color: var(--urgent); }
  .todo.overdue .when { color: var(--k-exam); }
  .todo.done .todo-title { text-decoration: line-through; color: var(--muted); font-weight: 500; }
  .todo.done { opacity: .7; }
  .link-btn {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center; min-width: 48px; min-height: 48px;
    margin: 4px 4px 4px 0; border-radius: 10px; color: var(--accent); text-decoration: none; font-size: .8rem; font-weight: 600;
  }
  .empty { padding: 16px; color: var(--muted); }
  .sync-status { font-size: .78rem; color: var(--muted); margin-top: 8px; min-height: 1.2em; }
  .sync-status.ok { color: var(--k-meeting); }
  .sync-status.offline { color: var(--k-followup); }

  .tag { display: inline-block; font-size: .72rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; line-height: 1.6; white-space: nowrap; }
  .tag.exam { color: var(--k-exam); background: var(--k-exam-bg); }
  .tag.assignment { color: var(--k-assignment); background: var(--k-assignment-bg); }
  .tag.meeting { color: var(--k-meeting); background: var(--k-meeting-bg); }
  .tag.followup { color: var(--k-followup); background: var(--k-followup-bg); }
  .tag.cancel { color: var(--k-cancel); background: var(--k-cancel-bg); }
  .tag.own { color: var(--k-own); background: var(--k-own-bg); }
  .tag.rel { color: var(--urgent); background: var(--urgent-bg); }
  .tag.new { color: var(--on-accent); background: var(--accent); }

  /* ---------- Takvim ---------- */
  .cal { padding: 8px 4px 12px; }
  .cal-head { display: flex; align-items: center; justify-content: space-between; }
  .cal-title { font-weight: 700; }
  .cal-nav { min-width: 44px; min-height: 44px; border: 0; border-radius: 10px; background: none; font-size: 1.6rem; line-height: 1; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1px; }
  .cal-dow span { text-align: center; font-size: .7rem; color: var(--muted); padding: 2px 0 4px; }
  .cal-cell {
    min-height: 46px; border: 0; border-radius: 10px; background: none; padding: 6px 0 4px;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
  }
  .cal-cell .num { font-size: .9rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .cal-cell.today .num { color: var(--accent); font-weight: 700; }
  .cal-cell.selected { background: var(--accent); }
  .cal-cell.selected .num { color: var(--on-accent); font-weight: 700; }
  .dots { display: flex; gap: 3px; margin-top: 4px; min-height: 6px; align-items: center; }
  .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--k-cancel); flex-shrink: 0; }
  .dot.exam { background: var(--k-exam); } .dot.assignment { background: var(--k-assignment); }
  .dot.meeting { background: var(--k-meeting); } .dot.followup { background: var(--k-followup); }
  .dot.own { background: #8b5cf6; } .dot.done { opacity: .35; }
  .cal-cell.selected .dot { box-shadow: 0 0 0 1.5px var(--on-accent); }
  .dots .more { font-style: normal; font-size: .6rem; line-height: 1; color: var(--muted); }
  .cal-day { border-top: 1px solid var(--line); margin-top: 8px; padding: 10px 6px 0; }
  .cal-day-title { font-weight: 600; margin-bottom: 4px; }
  .cal-none { color: var(--muted); font-size: .9rem; padding: 4px 0 8px; }
  .cal-item {
    display: flex; gap: 10px; align-items: flex-start; width: 100%; min-height: 44px; padding: 8px 4px;
    border: 0; border-top: 1px solid var(--line); background: none; text-align: left;
  }
  .cal-item .dot { margin-top: 8px; }
  .cal-item-text { display: flex; flex-direction: column; min-width: 0; }
  .cal-item-title { font-weight: 600; }
  .cal-item-meta { font-size: .8rem; color: var(--muted); }
  .cal-item.done .cal-item-title { text-decoration: line-through; color: var(--muted); }
  .cal-add { margin-top: 10px; width: 100%; }

  /* ---------- Mailler ---------- */
  .group { margin-bottom: 10px; overflow: hidden; }
  .group-head {
    width: 100%; display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 14px;
    border: 0; background: var(--surface-2); text-align: left; font-weight: 700;
  }
  .group-head .gname { min-width: 0; }
  .group-head .gcount { color: var(--muted); font-weight: 500; font-size: .82rem; white-space: nowrap; }
  .group.collapsed .group-body { display: none; }
  .group.collapsed .chev { transform: rotate(-45deg); }
  .mail-row { display: block; width: 100%; padding: 12px 14px; border: 0; border-top: 1px solid var(--line); background: none; text-align: left; }
  .mail-row:first-child { border-top: 0; }
  .mail-row:active { background: var(--surface-2); }
  .mail-subject { display: block; font-weight: 600; line-height: 1.35; margin-top: 2px; }
  .mail-from { display: block; font-size: .82rem; color: var(--muted); }
  .mail-snippet { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
                  font-size: .9rem; margin-top: 4px; color: color-mix(in srgb, var(--text) 85%, var(--muted)); }

  /* ---------- Pencereler (alt sayfa) ---------- */
  dialog.sheet {
    width: 100%; max-width: 640px; max-height: 92vh; max-height: 92dvh; margin: auto auto 0; padding: 0; border: 0;
    border-radius: 18px 18px 0 0; background: var(--surface); color: var(--text); overflow: hidden;
  }
  @media (min-width: 680px) { dialog.sheet { margin: auto; border-radius: 18px; } }
  dialog.sheet[open] { display: flex; flex-direction: column; }
  dialog.sheet::backdrop { background: rgba(0,0,0,.45); }
  .sheet-head { display: flex; align-items: flex-start; gap: 8px; padding: 14px 8px 8px 16px; border-bottom: 1px solid var(--line); flex-shrink: 0; }
  .sheet-head h3 { margin: 4px 0 0; font-size: 1.05rem; line-height: 1.35; flex: 1; min-width: 0; }
  .close-btn { flex-shrink: 0; width: 44px; height: 44px; border: 0; border-radius: 10px; background: var(--surface-2); font-size: 1.2rem; line-height: 1; }
  .sheet-body { padding: 14px 16px calc(18px + env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; min-height: 0; }
  .mv-meta { font-size: .85rem; color: var(--muted); }
  .mv-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
  .mv-info { background: var(--surface-2); border-radius: 10px; padding: 10px 12px; margin: 8px 0; font-size: .92rem; }
  .mv-text { white-space: pre-wrap; font-size: .95rem; line-height: 1.6; margin: 12px 0 0; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px; border: 0;
    border-radius: 10px; background: var(--accent); color: var(--on-accent); text-decoration: none; font-weight: 600; font-size: .9rem;
  }
  .btn.secondary { background: var(--surface-2); color: var(--text); border: 1px solid var(--line); }
  .btn.danger { background: var(--k-exam-bg); color: var(--k-exam); }
  .linkish { border: 0; background: none; color: var(--accent); font-weight: 600; padding: 10px 0; min-height: 44px; }

  /* form */
  .field { display: flex; flex-direction: column; gap: 4px; font-size: .85rem; font-weight: 600; margin-bottom: 12px; min-width: 0; }
  .field small { font-weight: 400; color: var(--muted); }
  .field input, .field textarea {
    font-size: 16px; font-weight: 400; background: var(--surface-2); border: 1px solid var(--line);
    border-radius: 10px; padding: 10px 12px; min-height: 46px; width: 100%; min-width: 0; display: block;
  }
  /* iOS'ta tarih/saat kutuları kendi genişliğini dayatıp taşmasın */
  .field input[type="date"], .field input[type="time"] { -webkit-appearance: none; appearance: none; line-height: 24px; }
  .field input::-webkit-date-and-time-value { text-align: left; }
  .field input:focus, .field textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; }
  .field-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
  .form-error { color: var(--k-exam); font-size: .85rem; min-height: 1.2em; margin: 0 0 8px; }
  .sheet-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .sheet-actions .spacer { flex: 1; }

  /* kategori listesi */
  .cat-row { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 4px; border-top: 1px solid var(--line); cursor: pointer; }
  .cat-row:first-child { border-top: 0; }
  .cat-row span { flex: 1; min-width: 0; }

  footer { margin-top: 28px; text-align: center; color: var(--muted); font-size: .76rem; }
</style>
</head>
<body>
<header class="top">
  <div class="wrap top-in">
    <div style="min-width:0">
      <h1>{{ r.title }}</h1>
      <div class="updated">{{ r.generated_text }}</div>
    </div>
    <div class="stats">
      <div class="stat" id="stat-new"><b>{{ r.new_count }}</b><span>Yeni</span></div>
      <div class="stat" id="stat-urgent"><b>{{ r.urgent_count }}</b><span>48 saat</span></div>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="note" role="region" aria-label="Not kağıdı">
    <div class="note-title">kevaşe başkan</div>
    <textarea id="note" rows="2" maxlength="2000" placeholder="Buraya istediğini yaz…" aria-label="Not"></textarea>
    <div class="note-status" id="note-status" aria-live="polite"></div>
  </div>

  <nav class="filters" aria-label="Filtre">
    <button class="chip" type="button" data-filter="all" aria-pressed="true">Tümü</button>
    <button class="chip" type="button" data-filter="academic" aria-pressed="false">📚 Dersler</button>
    <button class="chip" type="button" data-filter="club" aria-pressed="false">🎪 Kulüpler</button>
    <button class="chip" type="button" data-filter="own" aria-pressed="false">✍️ Görevlerim</button>
    <button class="chip cats" type="button" id="open-cats">Kategoriler <span id="hidden-count"></span></button>
  </nav>

  <section class="sec" data-sec="summary">
    <button class="sec-head" type="button" aria-expanded="true">Günlük Özet <i class="chev"></i></button>
    <div class="sec-body panel summary"><ul>{% for line in r.summary %}<li>{{ line }}</li>{% endfor %}</ul></div>
  </section>

  <section class="sec" data-sec="todo">
    <button class="sec-head" type="button" aria-expanded="true">Yapılacaklar <span class="count" id="todo-count"></span><i class="chev"></i></button>
    <div class="sec-body">
      <div class="todo-tools">
        <button class="add-btn" id="add-task" type="button">＋ Görev ekle</button>
        <button class="ghost-btn" id="toggle-done" type="button" aria-pressed="false">Bitenleri gizle</button>
      </div>
      <div class="panel" id="todo-list"><div class="empty">Yükleniyor…</div></div>
      <div class="sync-status" id="sync-status" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section class="sec" data-sec="cal">
    <button class="sec-head" type="button" aria-expanded="true">Takvim <i class="chev"></i></button>
    <div class="sec-body panel cal">
      <div class="cal-head">
        <button class="cal-nav" id="cal-prev" type="button" aria-label="Önceki ay">‹</button>
        <div class="cal-title" id="cal-title"></div>
        <button class="cal-nav" id="cal-next" type="button" aria-label="Sonraki ay">›</button>
      </div>
      <div class="cal-grid cal-dow" aria-hidden="true"><span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span><span>Cum</span><span>Cmt</span><span>Paz</span></div>
      <div class="cal-grid" id="cal-grid"></div>
      <div class="cal-day" id="cal-day"></div>
    </div>
  </section>

  <section class="sec" data-sec="mails">
    <button class="sec-head" type="button" aria-expanded="true">Mailler <span class="count" id="mail-count"></span><i class="chev"></i></button>
    <div class="sec-body" id="mail-groups"></div>
  </section>

  <footer>Mail taraması günde 2 kez yapılır · Bir maile dokununca tamamı açılır</footer>
</main>

<dialog class="sheet" id="mail-viewer" aria-labelledby="mv-subject">
  <div class="sheet-head">
    <h3 id="mv-subject"></h3>
    <button class="close-btn" type="button" data-close aria-label="Kapat">✕</button>
  </div>
  <div class="sheet-body" id="mv-body"></div>
</dialog>

<dialog class="sheet" id="task-sheet" aria-labelledby="sheet-title">
  <div class="sheet-head">
    <h3 id="sheet-title">Görev ekle</h3>
    <button class="close-btn" type="button" data-close aria-label="Kapat">✕</button>
  </div>
  <form class="sheet-body" id="task-form" novalidate>
    <label class="field">Başlık
      <input id="f-title" type="text" maxlength="200" autocomplete="off" placeholder="örn. MATH 107 çalışma kağıdı">
    </label>
    <div class="field-row">
      <label class="field">Tarih<input id="f-date" type="date"></label>
      <label class="field">Saat <small>(isteğe bağlı)</small><input id="f-time" type="time"></label>
    </div>
    <label class="field">Not <small>(isteğe bağlı)</small><textarea id="f-note" rows="2" maxlength="1000"></textarea></label>
    <p class="form-error" id="f-error" role="alert"></p>
    <div class="sheet-actions">
      <button type="button" class="btn danger" id="f-delete" hidden>Sil</button>
      <span class="spacer"></span>
      <button type="button" class="btn secondary" data-close>Vazgeç</button>
      <button type="submit" class="btn" id="f-save">Kaydet</button>
    </div>
  </form>
</dialog>

<dialog class="sheet" id="cat-sheet" aria-labelledby="cat-title">
  <div class="sheet-head">
    <h3 id="cat-title">Kategoriler</h3>
    <button class="close-btn" type="button" data-close aria-label="Kapat">✕</button>
  </div>
  <div class="sheet-body">
    <p class="mv-meta" style="margin:0 0 8px">İşaretini kaldırdığın kategoriler listede, takvimde ve maillerde gizlenir.</p>
    <div id="cat-list"></div>
    <div class="btn-row"><button class="btn secondary" type="button" id="cats-all">Hepsini göster</button></div>
  </div>
</dialog>

<script type="application/json" id="panel-data">{{ panel_data|safe }}</script>
<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("panel-data").textContent);
  var SYNC = DATA.sync;
  var MONTHS = ["Ocak","Şubat","Mart","Nisan","Mayıs","Haziran","Temmuz","Ağustos","Eylül","Ekim","Kasım","Aralık"];
  var DAYS = ["Pazar","Pazartesi","Salı","Çarşamba","Perşembe","Cuma","Cumartesi"];
  var H48 = 48 * 3600e3, D7 = 7 * 864e5;
  var OWN_GROUP = "Kendi görevlerim";
  var MAIL_BY_ID = {};
  DATA.mails.forEach(function (m) { MAIL_BY_ID[m.id] = m; });

  // ------------------------------------------------------------ depolama
  var LS = {
    get: function (k, d) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };
  var state = {
    tasks: LS.get("op-tasks", []), mailDone: LS.get("op-mail-done", []), pending: LS.get("op-pending", []),
    note: LS.get("op-note", ""), hideDone: LS.get("op-hide-done", false),
    filter: LS.get("op-filter", "all"), hidden: LS.get("op-hidden-groups", []),
    collapsed: LS.get("op-collapsed", {}), status: SYNC ? "syncing" : "local"
  };
  var legacy = LS.get("mail-panel-done", null);
  if (legacy) {
    Object.keys(legacy).forEach(function (k) { if (state.mailDone.indexOf(k) < 0) state.mailDone.push(k); });
    try { localStorage.removeItem("mail-panel-done"); } catch (e) {}
  }
  function persist() {
    LS.set("op-tasks", state.tasks); LS.set("op-mail-done", state.mailDone); LS.set("op-pending", state.pending);
    LS.set("op-note", state.note); LS.set("op-hide-done", state.hideDone); LS.set("op-filter", state.filter);
    LS.set("op-hidden-groups", state.hidden); LS.set("op-collapsed", state.collapsed);
  }
  function uid() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      var r = Math.random() * 16 | 0; return (c === "x" ? r : (r & 3 | 8)).toString(16);
    });
  }

  // ------------------------------------------------------------ senkron
  function rpc(fn, body) {
    body.p_key = SYNC.syncKey;
    return fetch(SYNC.url + "/rest/v1/rpc/" + fn, {
      method: "POST", headers: { "apikey": SYNC.key, "Content-Type": "application/json" }, body: JSON.stringify(body)
    }).then(function (r) {
      if (!r.ok) return r.text().then(function (t) { throw new Error(r.status + " " + t); });
      return r.text().then(function (t) { return t ? JSON.parse(t) : null; });
    });
  }
  function call(op) {
    if (op.type === "upsert") {
      var t = op.task;
      return rpc("panel_task_upsert", { p_id: t.id, p_title: t.title, p_due_date: t.due_date || null,
        p_due_time: t.due_time || null, p_note: t.note || null, p_done: !!t.done });
    }
    if (op.type === "delete") return rpc("panel_task_delete", { p_id: op.id });
    if (op.type === "note") return rpc("panel_note_set", { p_body: op.body });
    return rpc("panel_mail_done_set", { p_item_id: op.id, p_done: !!op.done });
  }
  var flushing = null;
  function flush() {
    if (!SYNC) return Promise.resolve();
    if (flushing) return flushing;
    flushing = (function next() {
      if (!state.pending.length) return Promise.resolve();
      return call(state.pending[0]).then(function () { state.pending.shift(); persist(); return next(); });
    })().then(function () { flushing = null; }, function (e) { flushing = null; throw e; });
    return flushing;
  }
  var pendingRender = false;
  function busy() {                                   // kullanıcı yazarken/okurken ekranı yeniden çizme
    return !!document.querySelector("dialog[open]") || document.activeElement === noteEl;
  }
  function pull() {
    if (!SYNC) return;
    setStatus("syncing");
    flush().then(function () { return rpc("panel_sync", {}); }).then(function (res) {
      if (state.pending.length) return;
      state.tasks = res.tasks || []; state.mailDone = res.mail_done || [];
      if (typeof res.note === "string" && !noteDirty && document.activeElement !== noteEl) {
        state.note = res.note; noteEl.value = res.note; growNote();
      }
      persist(); setStatus("ok");
      if (busy()) pendingRender = true; else render();
    }).catch(function () { setStatus("offline"); });
  }
  function queue(op) {
    if (op.type === "note") state.pending = state.pending.filter(function (o) { return o.type !== "note"; });
    state.pending.push(op); persist();
    if (!SYNC) { state.pending = []; persist(); return Promise.resolve(); }
    setStatus("syncing");
    return flush().then(function () { setStatus("ok"); }, function () { setStatus("offline"); });
  }
  function setStatus(s) {
    state.status = s;
    var el = document.getElementById("sync-status");
    el.textContent = {
      local: "Görevler bu cihazda saklanıyor.",
      syncing: "⟳ Senkronize ediliyor…",
      ok: "✓ Senkronize — tüm cihazlarında aynı.",
      offline: "⚠ Bağlantı yok — değişiklikler bu cihazda bekliyor, bağlanınca gönderilecek."
    }[s];
    el.className = "sync-status " + s;
  }

  // ------------------------------------------------------------ veri
  function ownDue(t) {
    if (!t.due_date) return null;
    var p = t.due_date.split("-"), hm = (t.due_time || "23:59").split(":");
    return new Date(+p[0], +p[1] - 1, +p[2], +hm[0], +hm[1]);
  }
  function allItems() {
    var list = DATA.mailTodos.map(function (m) {
      return { src: "mail", id: m.id, title: m.title, kind: m.kind, kindLabel: m.kindLabel, group: m.group, cat: m.cat,
               due: m.due ? new Date(m.due) : null, hasTime: m.hasTime, link: m.link, done: state.mailDone.indexOf(m.id) >= 0 };
    });
    state.tasks.forEach(function (t) {
      list.push({ src: "own", id: t.id, title: t.title, kind: "own", kindLabel: "Kendi görevim", group: OWN_GROUP, cat: "own",
                  note: t.note || "", due: ownDue(t), hasTime: !!t.due_time, done: !!t.done, task: t });
    });
    return list;
  }
  function passes(cat, group) {
    if (state.hidden.indexOf(group) >= 0) return false;
    return state.filter === "all" || state.filter === cat;
  }
  function bucketOf(it, now) {
    if (!it.due) return "none";
    var d = it.due - now;
    if (d < 0) return it.src === "own" ? "overdue" : "gone";
    if (d <= H48) return "urgent";
    if (d <= D7) return "soon";
    return "later";
  }
  function sameDay(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }
  function pad(n) { return (n < 10 ? "0" : "") + n; }
  function fmtDate(d, withTime) {
    return DAYS[d.getDay()] + ", " + d.getDate() + " " + MONTHS[d.getMonth()] + (withTime ? " · " + pad(d.getHours()) + ":" + pad(d.getMinutes()) : "");
  }
  function relText(due, now) {
    if (!due) return "";
    var days = Math.round((new Date(due.getFullYear(), due.getMonth(), due.getDate()) - new Date(now.getFullYear(), now.getMonth(), now.getDate())) / 864e5);
    if (due < now) return days === 0 ? "bugündü" : (-days) + " gün gecikti";
    if (days === 0) return "bugün";
    if (days === 1) return "yarın";
    return days + " gün sonra";
  }

  // ------------------------------------------------------------ DOM
  function el(tagName, cls, text) {
    var e = document.createElement(tagName);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }
  function tag(kind, label) { return el("span", "tag " + kind, label); }

  // ------------------------------------------------------------ yapılacaklar
  var BUCKETS = [["overdue", "Gecikmiş"], ["urgent", "48 saat içinde"], ["soon", "Bu hafta"], ["later", "Daha sonra"], ["none", "Tarihsiz"]];
  function todoRow(it, now) {
    var b = bucketOf(it, now);
    var row = el("div", "todo " + b + (it.done ? " done" : ""));
    var hit = el("label", "check-hit");
    var cb = el("input", "check"); cb.type = "checkbox"; cb.checked = it.done;
    cb.setAttribute("aria-label", "Tamamlandı: " + it.title);
    cb.addEventListener("change", function () { setDone(it, cb.checked); });
    hit.appendChild(cb); row.appendChild(hit);

    var open = el("button", "todo-open"); open.type = "button";
    open.appendChild(el("span", "todo-title", it.title));
    var m1 = el("span", "meta"); m1.appendChild(tag(it.kind, it.kindLabel));
    var sub = it.src === "own" ? it.note : it.group;
    if (sub) m1.appendChild(el("span", null, sub));
    open.appendChild(m1);
    var m2 = el("span", "meta");
    m2.appendChild(el("span", "when", it.due ? fmtDate(it.due, it.hasTime) : "Tarih yok"));
    var rel = relText(it.due, now);
    if (rel) m2.appendChild(/bugün|yarın|gecikti/.test(rel) ? tag("rel", rel) : el("span", null, "· " + rel));
    open.appendChild(m2);
    open.addEventListener("click", function () { if (it.src === "own") openTask(it.task); else openMail(it.id); });
    row.appendChild(open);

    if (it.src === "mail" && it.link) {
      var a = el("a", "link-btn", "Aç ↗"); a.href = it.link.url; a.target = "_blank"; a.rel = "noopener noreferrer";
      a.setAttribute("aria-label", it.link.label + " bağlantısını aç");
      row.appendChild(a);
    }
    return row;
  }
  function renderTodos(items, now) {
    var list = document.getElementById("todo-list");
    list.textContent = "";
    var vis = items.filter(function (it) { return bucketOf(it, now) !== "gone" && passes(it.cat, it.group); });
    document.getElementById("todo-count").textContent = "(" + vis.filter(function (i) { return !i.done; }).length + ")";
    var shown = 0;
    BUCKETS.forEach(function (bk) {
      var rows = vis.filter(function (it) { return bucketOf(it, now) === bk[0] && !(state.hideDone && it.done); });
      if (!rows.length) return;
      rows.sort(function (a, b) { return (a.due || 8.64e15) - (b.due || 8.64e15); });
      list.appendChild(el("div", "bucket " + bk[0], bk[1]));
      rows.forEach(function (it) { list.appendChild(todoRow(it, now)); shown++; });
    });
    if (!shown) list.appendChild(el("div", "empty", vis.length ? "Hepsi bitti! 🎉" : "Burada bekleyen bir iş yok. 🎉"));
    var tg = document.getElementById("toggle-done");
    tg.textContent = state.hideDone ? "Bitenleri göster" : "Bitenleri gizle";
    tg.setAttribute("aria-pressed", state.hideDone ? "true" : "false");
    var urgent = vis.filter(function (it) { var b = bucketOf(it, now); return !it.done && (b === "urgent" || b === "overdue"); }).length;
    var st = document.getElementById("stat-urgent");
    st.querySelector("b").textContent = urgent; st.classList.toggle("urgent", urgent > 0);
  }

  // ------------------------------------------------------------ takvim
  var cal = { y: new Date().getFullYear(), m: new Date().getMonth(), sel: new Date() };
  function renderCalendar(items, now) {
    var vis = items.filter(function (it) { return it.due && bucketOf(it, now) !== "gone" && passes(it.cat, it.group); });
    document.getElementById("cal-title").textContent = MONTHS[cal.m] + " " + cal.y;
    var grid = document.getElementById("cal-grid"); grid.textContent = "";
    var offset = (new Date(cal.y, cal.m, 1).getDay() + 6) % 7, daysIn = new Date(cal.y, cal.m + 1, 0).getDate();
    for (var i = 0; i < offset; i++) grid.appendChild(el("span"));
    for (var d = 1; d <= daysIn; d++) (function (day) {
      var date = new Date(cal.y, cal.m, day);
      var its = vis.filter(function (it) { return sameDay(it.due, date); });
      var btn = el("button", "cal-cell"); btn.type = "button";
      if (sameDay(date, now)) btn.classList.add("today");
      if (sameDay(date, cal.sel)) btn.classList.add("selected");
      btn.appendChild(el("span", "num", String(day)));
      var dots = el("span", "dots");
      its.slice(0, 3).forEach(function (it) { dots.appendChild(el("i", "dot " + it.kind + (it.done ? " done" : ""))); });
      if (its.length > 3) dots.appendChild(el("i", "more", "+"));
      btn.appendChild(dots);
      btn.setAttribute("aria-label", day + " " + MONTHS[cal.m] + (its.length ? ", " + its.length + " iş" : ""));
      btn.addEventListener("click", function () { cal.sel = date; render(); });
      grid.appendChild(btn);
    })(d);
    var box = document.getElementById("cal-day"); box.textContent = "";
    var sel = cal.sel;
    box.appendChild(el("div", "cal-day-title", fmtDate(sel, false)));
    var dayItems = vis.filter(function (it) { return sameDay(it.due, sel); }).sort(function (a, b) { return a.due - b.due; });
    if (!dayItems.length) box.appendChild(el("div", "cal-none", "Bu gün için bir şey yok."));
    dayItems.forEach(function (it) {
      var r = el("button", "cal-item" + (it.done ? " done" : "")); r.type = "button";
      r.addEventListener("click", function () { if (it.src === "own") openTask(it.task); else openMail(it.id); });
      r.appendChild(el("span", "dot " + it.kind));
      var t = el("span", "cal-item-text");
      t.appendChild(el("span", "cal-item-title", it.title));
      t.appendChild(el("span", "cal-item-meta", (it.hasTime ? pad(it.due.getHours()) + ":" + pad(it.due.getMinutes()) + " · " : "") + it.kindLabel + " · " + it.group));
      r.appendChild(t); box.appendChild(r);
    });
    var add = el("button", "btn secondary cal-add", "＋ Bu güne görev ekle"); add.type = "button";
    add.addEventListener("click", function () { openTask(null, sel.getFullYear() + "-" + pad(sel.getMonth() + 1) + "-" + pad(sel.getDate())); });
    box.appendChild(add);
  }

  // ------------------------------------------------------------ mailler
  function shortDate(iso) { var d = new Date(iso); return d.getDate() + " " + MONTHS[d.getMonth()] + " " + pad(d.getHours()) + ":" + pad(d.getMinutes()); }
  function renderMails() {
    var box = document.getElementById("mail-groups"); box.textContent = "";
    var vis = DATA.mails.filter(function (m) { return passes(m.cat, m.group); });
    document.getElementById("mail-count").textContent = "(" + vis.length + ")";
    if (!vis.length) {
      box.appendChild(el("div", "panel empty", state.filter === "own" ? "Bu filtrede mail yok — kendi görevlerin yukarıda." : "Gösterilecek mail yok."));
      return;
    }
    var groups = {}, order = [];
    vis.forEach(function (m) {
      if (!groups[m.group]) { groups[m.group] = []; order.push(m.group); }
      groups[m.group].push(m);
    });
    function newCount(g) { return groups[g].filter(function (m) { return m.isNew; }).length; }
    order.sort(function (a, b) { return newCount(b) - newCount(a) || a.localeCompare(b, "tr"); });
    order.forEach(function (g) {
      var key = "g:" + g;
      var wrap = el("div", "panel group" + (state.collapsed[key] ? " collapsed" : ""));
      var head = el("button", "group-head"); head.type = "button";
      head.setAttribute("aria-expanded", state.collapsed[key] ? "false" : "true");
      head.appendChild(el("span", "gname", (groups[g][0].cat === "club" ? "🎪 " : "📚 ") + g));
      var nNew = newCount(g);
      head.appendChild(el("span", "gcount", groups[g].length + " mail" + (nNew ? " · " + nNew + " yeni" : "")));
      head.appendChild(el("i", "chev"));
      head.addEventListener("click", function () {
        state.collapsed[key] = !state.collapsed[key]; persist();
        wrap.classList.toggle("collapsed", !!state.collapsed[key]);
        head.setAttribute("aria-expanded", state.collapsed[key] ? "false" : "true");
      });
      wrap.appendChild(head);
      var body = el("div", "group-body");
      groups[g].forEach(function (m) {
        var row = el("button", "mail-row"); row.type = "button";
        var tags = el("span", "meta");
        if (m.isNew) tags.appendChild(tag("new", "Yeni"));
        m.kinds.forEach(function (k, i) { if (m.kindLabels[i]) tags.appendChild(tag(k, m.kindLabels[i])); });
        if (m.due) tags.appendChild(el("span", "when", "🗓 " + fmtDate(new Date(m.due), m.hasTime)));
        if (tags.childNodes.length) row.appendChild(tags);
        row.appendChild(el("span", "mail-subject", m.subject));
        row.appendChild(el("span", "mail-from", m.from + " · " + shortDate(m.date) + (m.thread > 1 ? " · " + m.thread + " mesaj" : "")));
        if (m.snippet) row.appendChild(el("span", "mail-snippet", m.snippet));
        row.addEventListener("click", function () { openMail(m.id); });
        body.appendChild(row);
      });
      wrap.appendChild(body); box.appendChild(wrap);
    });
  }

  // ------------------------------------------------------------ pencereler
  var lastFocus = null;
  function showSheet(d) {
    lastFocus = document.activeElement;
    document.body.classList.add("modal-open");
    if (d.showModal) d.showModal(); else d.setAttribute("open", "");
  }
  function afterClose() {                            // pencere kapanınca (hemen, olay beklemeden)
    if (document.querySelector("dialog[open]")) return;
    document.body.classList.remove("modal-open");
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) {} }
    if (pendingRender) { pendingRender = false; render(); }
  }
  function closeSheet(d) {
    if (d.close) d.close(); else d.removeAttribute("open");
    afterClose();
  }
  Array.prototype.forEach.call(document.querySelectorAll("dialog.sheet"), function (d) {
    d.addEventListener("close", afterClose);         // Esc / geri tuşu ile kapanınca
    d.addEventListener("click", function (e) { if (e.target === d || (e.target.hasAttribute && e.target.hasAttribute("data-close"))) closeSheet(d); });
  });

  function openMail(id) {
    var m = MAIL_BY_ID[id];
    if (!m) return;
    var d = document.getElementById("mail-viewer");
    document.getElementById("mv-subject").textContent = m.subject;
    var b = document.getElementById("mv-body"); b.textContent = "";
    b.appendChild(el("div", "mv-meta", m.from + (m.fromEmail ? " <" + m.fromEmail + ">" : "")));
    b.appendChild(el("div", "mv-meta", shortDate(m.date) + " · " + m.group + (m.thread > 1 ? " · " + m.thread + " mesajlık konunun en yenisi" : "")));
    var tags = el("div", "mv-tags");
    m.kinds.forEach(function (k, i) { if (m.kindLabels[i]) tags.appendChild(tag(k, m.kindLabels[i])); });
    if (tags.childNodes.length) b.appendChild(tags);
    if (m.due || (m.event && m.event.location)) {
      var info = el("div", "mv-info");
      if (m.due) info.appendChild(el("div", null, "🗓 " + fmtDate(new Date(m.due), m.hasTime) + " (" + relText(new Date(m.due), new Date()) + ")"));
      if (m.event && m.event.location) info.appendChild(el("div", null, "📍 " + m.event.location));
      b.appendChild(info);
    }
    if (m.links.length) {
      var lr = el("div", "btn-row");
      m.links.forEach(function (l, i) {
        var a = el("a", "btn" + (i ? " secondary" : ""), l.label); a.href = l.url; a.target = "_blank"; a.rel = "noopener noreferrer";
        lr.appendChild(a);
      });
      b.appendChild(lr);
    }
    if (m.attachments.length) b.appendChild(el("div", "mv-info", "📎 Ekler: " + m.attachments.join(", ")));
    var text = el("div", "mv-text", m.body || "(Metin yok)");
    b.appendChild(text);
    if (m.raw) {
      var full = false, tgl = el("button", "linkish", "İmza ve alıntılar dahil tamamını göster"); tgl.type = "button";
      tgl.addEventListener("click", function () {
        full = !full; text.textContent = full ? m.raw : m.body;
        tgl.textContent = full ? "Sadeleştirilmiş hâline dön" : "İmza ve alıntılar dahil tamamını göster";
      });
      b.appendChild(tgl);
    }
    var actions = el("div", "btn-row");
    if (DATA.mailTodos.some(function (t) { return t.id === id; })) {
      var done = state.mailDone.indexOf(id) >= 0;
      var db = el("button", "btn" + (done ? " secondary" : ""), done ? "Bitmedi olarak işaretle" : "✓ Bitti olarak işaretle"); db.type = "button";
      db.id = "mv-done";
      db.addEventListener("click", function () { pendingRender = true; setDone({ src: "mail", id: id }, !done, true); closeSheet(d); });
      actions.appendChild(db);
    }
    var gm = el("a", "btn secondary", "Gmail'de aç");
    gm.href = "https://mail.google.com/mail/u/0/#search/" + encodeURIComponent('subject:"' + m.subject.replace(/"/g, "") + '"');
    gm.target = "_blank"; gm.rel = "noopener noreferrer";
    actions.appendChild(gm);
    b.appendChild(actions);
    showSheet(d);
    b.scrollTop = 0;
  }

  // görev formu
  var taskSheet = document.getElementById("task-sheet"), editing = null, delArmed = false;
  var fTitle = document.getElementById("f-title"), fDate = document.getElementById("f-date"), fTime = document.getElementById("f-time"),
      fNote = document.getElementById("f-note"), fErr = document.getElementById("f-error"), fDel = document.getElementById("f-delete");
  function openTask(task, presetDate) {
    editing = task || null; delArmed = false;
    document.getElementById("sheet-title").textContent = task ? "Görevi düzenle" : "Görev ekle";
    fTitle.value = task ? task.title : ""; fDate.value = task ? (task.due_date || "") : (presetDate || "");
    fTime.value = task ? (task.due_time || "") : ""; fNote.value = task ? (task.note || "") : "";
    fErr.textContent = ""; fDel.hidden = !task; fDel.textContent = "Sil";
    showSheet(taskSheet);
  }
  document.getElementById("add-task").addEventListener("click", function () { openTask(null); });
  document.getElementById("task-form").addEventListener("submit", function (e) {
    e.preventDefault();
    var title = fTitle.value.trim();
    if (!title) { fErr.textContent = "Başlık boş olamaz."; fTitle.focus(); return; }
    if (fTime.value && !fDate.value) { fErr.textContent = "Saat girdiysen tarihi de seç."; fDate.focus(); return; }
    var t = editing || { id: uid(), done: false };
    t.title = title; t.due_date = fDate.value || null; t.due_time = fTime.value || null; t.note = fNote.value.trim() || null;
    if (!editing) state.tasks.push(t);
    if (t.due_date) { var p = t.due_date.split("-"); cal.y = +p[0]; cal.m = +p[1] - 1; cal.sel = new Date(+p[0], +p[1] - 1, +p[2]); }
    persist(); pendingRender = true; closeSheet(taskSheet);
    queue({ type: "upsert", task: t });
  });
  fDel.addEventListener("click", function () {
    if (!delArmed) { delArmed = true; fDel.textContent = "Emin misin? Sil"; return; }
    var id = editing.id;
    state.tasks = state.tasks.filter(function (x) { return x.id !== id; });
    persist(); pendingRender = true; closeSheet(taskSheet);
    queue({ type: "delete", id: id });
  });

  function setDone(it, done, noRender) {
    if (it.src === "mail") {
      var i = state.mailDone.indexOf(it.id);
      if (done && i < 0) state.mailDone.push(it.id);
      if (!done && i >= 0) state.mailDone.splice(i, 1);
      persist(); if (!noRender) render();
      queue({ type: "mail", id: it.id, done: done });
    } else {
      it.task.done = done; persist(); if (!noRender) render();
      queue({ type: "upsert", task: it.task });
    }
  }

  // kategoriler
  function allGroups() {
    var seen = {}, out = [];
    DATA.mails.concat(DATA.mailTodos).forEach(function (m) { if (!seen[m.group]) { seen[m.group] = 1; out.push([m.group, m.cat]); } });
    out.sort(function (a, b) { return a[1].localeCompare(b[1]) || a[0].localeCompare(b[0], "tr"); });
    out.push([OWN_GROUP, "own"]);
    return out;
  }
  function renderCats() {
    var box = document.getElementById("cat-list"); box.textContent = "";
    allGroups().forEach(function (g) {
      var row = el("label", "cat-row");
      var cb = el("input", "check"); cb.type = "checkbox"; cb.checked = state.hidden.indexOf(g[0]) < 0;
      cb.addEventListener("change", function () {
        var i = state.hidden.indexOf(g[0]);
        if (cb.checked && i >= 0) state.hidden.splice(i, 1);
        if (!cb.checked && i < 0) state.hidden.push(g[0]);
        persist(); pendingRender = true; renderFilters();
      });
      row.appendChild(cb);
      row.appendChild(el("span", null, (g[1] === "club" ? "🎪 " : g[1] === "own" ? "✍️ " : "📚 ") + g[0]));
      box.appendChild(row);
    });
  }
  document.getElementById("open-cats").addEventListener("click", function () { renderCats(); showSheet(document.getElementById("cat-sheet")); });
  document.getElementById("cats-all").addEventListener("click", function () { state.hidden = []; persist(); renderCats(); renderFilters(); pendingRender = true; });
  function renderFilters() {
    Array.prototype.forEach.call(document.querySelectorAll(".chip[data-filter]"), function (c) {
      c.setAttribute("aria-pressed", c.getAttribute("data-filter") === state.filter ? "true" : "false");
    });
    document.getElementById("hidden-count").textContent = state.hidden.length ? "(" + state.hidden.length + " gizli)" : "";
  }
  Array.prototype.forEach.call(document.querySelectorAll(".chip[data-filter]"), function (c) {
    c.addEventListener("click", function () { state.filter = c.getAttribute("data-filter"); persist(); render(); });
  });

  // katlanır bölümler
  Array.prototype.forEach.call(document.querySelectorAll(".sec"), function (s) {
    var key = "s:" + s.getAttribute("data-sec"), head = s.querySelector(".sec-head");
    function apply() { s.classList.toggle("collapsed", !!state.collapsed[key]); head.setAttribute("aria-expanded", state.collapsed[key] ? "false" : "true"); }
    head.addEventListener("click", function () { state.collapsed[key] = !state.collapsed[key]; persist(); apply(); });
    apply();
  });

  // not kağıdı
  var noteEl = document.getElementById("note"), noteStatus = document.getElementById("note-status"), noteTimer = null, noteDirty = false;
  function growNote() { noteEl.style.height = "auto"; noteEl.style.height = Math.max(72, noteEl.scrollHeight) + "px"; }
  noteEl.value = state.note; growNote();
  noteEl.addEventListener("input", function () {
    growNote(); noteDirty = true; noteStatus.textContent = "…";
    clearTimeout(noteTimer); noteTimer = setTimeout(saveNote, 700);
  });
  noteEl.addEventListener("blur", function () {
    if (noteDirty) { clearTimeout(noteTimer); saveNote(); }
    if (pendingRender && !busy()) { pendingRender = false; render(); }
  });
  function saveNote() {
    state.note = noteEl.value; persist();
    queue({ type: "note", body: state.note }).then(function () {
      noteDirty = false;
      noteStatus.textContent = !SYNC ? "Bu cihazda kaydedildi ✓" : state.status === "ok" ? "Kaydedildi ✓" : "Cihazda kaydedildi, bağlanınca gönderilecek";
    });
  }

  // diğer
  document.getElementById("toggle-done").addEventListener("click", function () { state.hideDone = !state.hideDone; persist(); render(); });
  document.getElementById("cal-prev").addEventListener("click", function () { cal.m--; if (cal.m < 0) { cal.m = 11; cal.y--; } render(); });
  document.getElementById("cal-next").addEventListener("click", function () { cal.m++; if (cal.m > 11) { cal.m = 0; cal.y++; } render(); });
  document.addEventListener("visibilitychange", function () { if (!document.hidden) pull(); });
  window.addEventListener("online", pull);

  function render() {
    var now = new Date(), items = allItems();
    var y = window.scrollY;                          // yeniden çizimde sayfa zıplamasın
    renderFilters(); renderTodos(items, now); renderCalendar(items, now); renderMails();
    window.scrollTo(0, y);
  }

  setStatus(state.status);
  render();
  pull();
})();
</script>
</body>
</html>
